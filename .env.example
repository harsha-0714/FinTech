# Environment variables for FinTech chatbot
# Copy this file to .env and fill in the values.
# .env is git-ignored; never commit real keys.

# Optional: Alpha Vantage API key (free tier: https://www.alphavantage.co/support/#api-key)
# Used as a fallback when yfinance is unavailable.
ALPHA_VANTAGE_KEY=your_alpha_vantage_api_key_here

# Flask settings
FLASK_DEBUG=false
PORT=5000
